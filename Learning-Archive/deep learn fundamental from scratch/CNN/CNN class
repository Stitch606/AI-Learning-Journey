        kernels = np.random.randn(num, s, s)
        kernels_moves = np.lib.stride_tricks.sliding_window_view(self.img_array,(s,s))
        k = s*s
        m = kernels_moves.shape[0] * kernels_moves.shape[1]
        kernel = kernels.reshape(num,k).T
