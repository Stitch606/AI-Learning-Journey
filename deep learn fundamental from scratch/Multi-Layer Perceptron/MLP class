import numpy as np

class MLP:

    def __init__(self, lr, layer_dims, X):
        self.X = X
        self.lr = lr
        self.layer_dims = layer_dims

    def initialize_parameters(self):

        self.weights = {}
        self.bias = {}

        self.num_layers = len(self.layer_dims) - 1

        for i in range(1, self.num_layers + 1):

            self.weights["w" + str(i)] = (
                np.random.randn(
                    self.layer_dims[i],
                    self.layer_dims[i-1]
                ) * 0.01
            )

            self.bias["b" + str(i)] = np.zeros(
                (self.layer_dims[i], 1)
            )


    def forward_propagation(self):

        self.cache = {}

        A = self.X.T

        self.cache["a0"] = A

        for i in range(1, self.num_layers):

            W = self.weights[f"w{i}"]
            b = self.bias[f"b{i}"]

            Z = np.dot(W, A) + b

            A = np.maximum(0, Z)

            self.cache[f"z{i}"] = Z
            self.cache[f"a{i}"] = A


        # output layer

        W = self.weights[f"w{self.num_layers}"]
        b = self.bias[f"b{self.num_layers}"]

        Z = np.dot(W, A) + b

        A = 1 / (1 + np.exp(-Z))

        self.cache[f"z{self.num_layers}"] = Z
        self.cache[f"a{self.num_layers}"] = A

        return A



    def back_propagation(self, y):

        m = y.shape[1]

        prediction = self.cache[f"a{self.num_layers}"]

        error = prediction - y

        self.new_w = {}
        self.new_b = {}


        for i in range(self.num_layers, 0, -1):

            A_previous = self.cache[f"a{i-1}"]

            W = self.weights[f"w{i}"]


            dW = np.dot(error, A_previous.T) / m

            db = np.mean(error, axis=1, keepdims=True)


            self.new_w[f"w{i}"] = W - self.lr * dW

            self.new_b[f"b{i}"] = (
                self.bias[f"b{i}"] - self.lr * db
            )


            error = np.dot(W.T, error)


        return self.new_w, self.new_b
